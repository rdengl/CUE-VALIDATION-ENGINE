Request: {
  // Roles must contain ALL of these
  rolesAll: [...string] @tag(message="rolesAll must contain all required values", required_values="admin,user,editor")

  // Roles must contain AT LEAST ONE of these
  rolesAny: [...string] @tag(message="rolesAny must contain at least one of the required values", contains_one="moderator,guest")

    // Roles must contain AT LEAST ONE of these
  rolesAnyInt: [...int] @tag(message="rolesAny must contain at least one of the required values", contains_one="1,2")

  // Roles must NOT contain these
  rolesNone: [...string] @tag(message="rolesNone must not contain any of the forbidden values", not_contains="banned,disabled")

  // Example of other fields still working
  age: int & >= 18 & <= 60 @tag(message="Age must be between 18 and 60")

  dob: string & =~"^\\d{4}-\\d{2}-\\d{2}$" @tag(message="DOB must be in yyyy-MM-dd format", date="yyyy-MM-dd")

  amount: number & >= 0.00 & <= 99999999.99 @tag(message="Invalid amount", decimal="2")
}




